      "@id": "sgkg:evidence"
    },
    "location": {
      "@id": "sgkg:location"
    },
    "quote": {
      "@id": "sgkg:quote"
    },
    "note": {
      "@id": "skos:note"
    },
    "skill": {
      "@id": "sgkg:skill"
    },
    "generatedAt": {
      "@id": "prov:generatedAtTime",
      "@type": "xsd:dateTime"
    },
    "wasDerivedFrom": {
      "@id": "prov:wasDerivedFrom",
      "@type": "@id"
    },
    "ontologyVersion": {
      "@id": "sgkg:ontologyVersion"
    },
    "contains": {
      "@id": "http://smart.who.int/kg/contains"
    },
    "hasSupplement": {
      "@id": "http://smart.who.int/kg/hasSupplement"
    },
